# Cortex AI environment example
# Never commit real credentials.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Google OAuth (optional; required to enable Google sign-in/sign-up)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Private admin UI login uses the fixed owner username ehsanam86. Keep the session signing secret out of Git.
CORTEX_ADMIN_SESSION_SECRET=replace-with-another-long-random-secret


# Production knowledge file storage (Cloudflare R2 / S3-compatible API)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=cortex-ai-knowledge
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional LLM fallback
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_AUTH_MODE=bearer
OPENROUTER_API_KEY=
# Managed Cortex model defaults; provider IDs remain server-side.
CORTEX_MODEL_LAUNCH_FAST=
CORTEX_MODEL_LAUNCH_BALANCED=
CORTEX_MODEL_GROWTH_FLASH=
CORTEX_MODEL_GROWTH_MAX=
CORTEX_MODEL_SCALE_SONNET=
CORTEX_MODEL_ENTERPRISE_OPUS=
OPENROUTER_MODEL=

# Optional neural embeddings
EMBEDDINGS_PROVIDER=
OPENAI_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_DIMS=

# Optional Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Telegram / public URL
APP_PUBLIC_URL=
TELEGRAM_INTERNAL_SECRET=

# Runtime tuning
MAX_UPLOAD_MB=20
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=8
MIN_SIMILARITY_SCORE=0.09
COOKIE_SECURE=true
APP_ENV=production
CORTEX_BILLING_ENFORCE=true

# Real credit top-up payment (ZarinPal)
CORTEX_ZARINPAL_MERCHANT_ID=
CORTEX_ZARINPAL_SANDBOX=false
CORTEX_PAYMENT_CALLBACK_URL=
CORTEX_CUSTOMER_APP_URL=

# Transactional email for password reset (Resend)
CORTEX_RESEND_API_KEY=
CORTEX_EMAIL_FROM="Cortex AI <no-reply@your-domain.com>"


# Real model fine-tuning / self-improvement
CORTEX_TRAINING_WORKER_URL=""
CORTEX_TRAINING_WORKER_SECRET=""
CORTEX_TRAINING_CALLBACK_URL=""
CORTEX_TRAINING_CALLBACK_SECRET=""
CORTEX_TRAINING_BASE_MODEL="Qwen/Qwen3-0.6B"
CORTEX_TRAINING_MIN_EXAMPLES="8"
CORTEX_TRAINING_MAX_EXAMPLES="2000"
CORTEX_TRAINING_MAX_EVAL_LOSS="2.8"
CORTEX_AUTO_IMPROVE_SECRET=""

# Self-hosted trained-model inference supply rates (USD / 1M tokens)
CORTEX_TRAINED_INPUT_USD_PER_1M="0.50"
CORTEX_TRAINED_OUTPUT_USD_PER_1M="1.50"
