# Database (required in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Application security (required in production)
APP_SECRET_KEY=replace-with-a-long-random-secret

# Optional LLM fallback settings
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_AUTH_MODE=bearer

# Optional public URL / Telegram settings
APP_PUBLIC_URL=
TELEGRAM_INTERNAL_SECRET=
COOKIE_SECURE=true
APP_ENV=production
