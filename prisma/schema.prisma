generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]      @relation("WorkspaceOwner")
  conversations   Conversation[]
  usageEvents     UsageEvent[]
  auditLogs       AuditLog[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        WorkspaceMember[]
  agents         Agent[]
  providerConfig ProviderConfig?
  agentProviderConfigs AgentProviderConfig[]
  telegramBots   TelegramBot[]
  providerHealth AgentProviderHealth[]
  usageEvents    UsageEvent[]
  auditLogs      AuditLog[]
  usagePolicy    UsagePolicy?
  usageReservations UsageReservation[]
  workflows       Workflow[]
  executions      Execution[]
  memoryEntries   MemoryEntry[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  orgName      String?
  description  String?
  language     String   @default("fa")
  tone         String   @default("professional")
  customTone       String?
  instructions     String?
  persona          String?
  systemPrompt     String?
  temperature      Float    @default(0.7)
  topP             Float    @default(1.0)
  maxTokens        Int      @default(1200)
  memoryEnabled    Boolean  @default(true)
  citationsEnabled Boolean  @default(true)
  status           String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConfig   AgentProviderConfig?
  knowledgeSources KnowledgeSource[]
  conversations    Conversation[]
  usageEvents      UsageEvent[]
  telegramBots     TelegramBot[]
  apiKeys          AgentApiKey[]
  tools             AgentTool[]
  workflows        Workflow[]
  executions       Execution[]
  memoryEntries    MemoryEntry[]
  providerHealth  AgentProviderHealth?

  @@index([workspaceId])
}

model AgentProviderConfig {
  id              String   @id @default(cuid())
  agentId         String   @unique
  workspaceId     String
  providerName    String
  providerType   String?  // legacy production column; retained for backward-compatible schema sync
  baseUrl         String
  model           String
  protocol        String   @default("openai-compatible")
  authMode        String   @default("bearer")
  apiKeyEncrypted String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AgentApiKey {
  id         String   @id @default(cuid())
  agentId    String
  name       String
  keyHash    String   @unique
  keyPrefix  String
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, active])
}

model KnowledgeSource {
  id        String   @id @default(cuid())
  agentId   String
  name      String
  type      String
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@index([agentId])
  @@index([status])
}

model KnowledgeDocument {
  id         String   @id @default(cuid())
  sourceId   String
  name       String
  mimeType   String?
  sizeBytes  Int?
  url        String?
  status     String   @default("pending")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([sourceId])
}

model KnowledgeChunk {
  id          String   @id
  documentId  String
  sourceId    String
  agentId     String
  workspaceId String
  seq         Int
  text        String
  page        Int?
  section     String?
  sourceUrl   String?
  metadata    String?
  createdAt   DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([agentId])
  @@index([sourceId])
}

model VectorPoint {
  id          String   @id
  agentId     String
  workspaceId String
  sourceId    String
  documentId  String
  vector      String
  dims        Int
  payload     String
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([workspaceId])
  @@index([sourceId])
}

model Conversation {
  id             String   @id @default(cuid())
  agentId        String
  userId         String?
  title          String   @default("گفتگوی جدید")
  channel        String   @default("web")
  externalUserId String?
  telegramBotId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramBot TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)
  messages    Message[]
  memoryEntries MemoryEntry[]

  @@index([agentId])
  @@index([userId])
  @@index([telegramBotId])
  @@index([externalUserId])
  @@index([channel])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
}

model ProviderConfig {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  providerName    String
  baseUrl         String
  model           String
  authMode        String   @default("bearer")
  apiKeyEncrypted String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsagePolicy {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  dailyMessageLimit     Int      @default(0)
  monthlyMessageLimit  Int      @default(0)
  dailyTokenLimit      Int      @default(0)
  monthlyTokenLimit    Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model TelegramBot {
  id                    String   @id @default(cuid())
  workspaceId           String
  agentId               String
  name                  String
  tokenEncrypted        String
  username              String?
  status                String   @default("disconnected")
  mode                  String   @default("webhook")
  webhookSecretEncrypted String?
  lastError             String?
  lastSeenAt            DateTime?
  lastUpdateId          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent      Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  allowlist  TelegramAllowlistEntry[]
  users      TelegramUser[]
  conversations Conversation[]
  usageEvents UsageEvent[]
  processedUpdates TelegramProcessedUpdate[]
  profile TelegramBotProfile?

  @@index([workspaceId])
  @@index([agentId])
  @@index([status])
}

model TelegramAllowlistEntry {
  id          String   @id @default(cuid())
  botId       String
  phoneNumber String
  displayName String?
  notes       String?
  status      String   @default("allowed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, phoneNumber])
  @@index([botId, status])
}

model TelegramProcessedUpdate {
  id          String   @id @default(cuid())
  botId       String
  updateId    Int
  status      String   @default("processing")
  attempts    Int      @default(1)
  lastError   String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, updateId])
  @@index([botId, status])
  @@index([updatedAt])
}

model TelegramBotProfile {
  id                    String   @id @default(cuid())
  botId                  String   @unique
  displayName            String   @default("")
  shortDescription       String   @default("")
  description            String   @default("")
  welcomeTitle           String   @default("✨ خوش آمدید")
  welcomeText            String   @default("من دستیار هوشمند Cortex هستم و به دانش و ایجنت این ربات متصل‌ام.\n\nبدون ثبت شماره موبایل شروع کنید؛ فقط پیام‌تان را بفرستید. 🚀")
  welcomeBannerUrl       String?
  helpText               String   @default("💬 پیام عادی → پاسخ از ایجنت\n🆕 گفتگوی جدید → یک conversation تازه\n📊 مصرف → وضعیت استفاده\n\nسؤال را کامل و واضح بفرستید.")
  newChatText            String   @default("✅ گفتگوی جدید آماده است. پیام بعدی‌تان را بفرستید.")
  blockedText            String   @default("⛔ دسترسی این حساب مسدود است.")
  errorText              String   @default("⚠️ در پردازش این پیام مشکلی پیش آمد. لطفاً چند لحظه بعد دوباره تلاش کنید.")
  thinkingMessages       String   @default("[\"🧠 در حال فکر کردن…\",\"🔎 در حال بررسی اطلاعات…\",\"✍️ در حال آماده‌سازی پاسخ…\"]")
  newChatButtonText      String   @default("🆕 گفتگوی جدید")
  helpButtonText         String   @default("❓ راهنما")
  usageButtonText        String   @default("📊 مصرف")
  showThinking           Boolean  @default(true)
  showWelcomeBanner      Boolean  @default(false)
  commandsJson           String   @default("[]")
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model TelegramUser {
  id             String   @id @default(cuid())
  botId          String
  telegramUserId String
  phoneNumber    String?
  username       String?
  firstName      String?
  lastName       String?
  status         String   @default("pending")
  dailyMessageLimit   Int   @default(0)
  monthlyMessageLimit Int   @default(0)
  dailyTokenLimit     Int   @default(0)
  monthlyTokenLimit   Int   @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
  usageReservations UsageReservation[]

  @@unique([botId, telegramUserId])
  @@index([botId, status])
}

model UsageReservation {
  id              String   @id @default(cuid())
  workspaceId     String
  telegramUserId  String?
  messages        Int      @default(0)
  tokens          Int      @default(0)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramUser TelegramUser? @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, expiresAt])
  @@index([expiresAt])
  @@index([telegramUserId, createdAt])
  @@index([telegramUserId, expiresAt])
}

model UsageEvent {
  id                 String   @id @default(cuid())
  workspaceId        String
  agentId            String?
  userId             String?
  telegramBotId      String?
  telegramUserId     String?
  channel            String   @default("web")
  provider           String?
  model              String?
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  totalTokens        Int      @default(0)
  estimatedCostMicros Int     @default(0)
  createdAt          DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramBot TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)
  telegramUser TelegramUser? @relation(fields: [telegramUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([telegramBotId, createdAt])
  @@index([telegramUserId, createdAt])
  @@index([channel, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, createdAt])
}


model ToolDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  inputSchema String
  outputSchema String?
  permissions String   @default("READ")
  kind        String   @default("builtin")
  configJson  String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agents AgentTool[]
  @@index([enabled])
}

model AgentTool {
  id         String   @id @default(cuid())
  agentId    String
  toolId     String
  enabled    Boolean  @default(true)
  configJson String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool ToolDefinition @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@unique([agentId, toolId])
  @@index([agentId, enabled])
}

model Workflow {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  name        String
  description String?
  definition  String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  triggers Trigger[]
  executions Execution[]
  @@index([workspaceId])
  @@index([agentId])
}

model Trigger {
  id         String   @id @default(cuid())
  workflowId String
  type       String
  configJson String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  @@index([workflowId, enabled])
}

model Execution {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  workflowId  String?
  triggerType String
  status      String   @default("QUEUED")
  input       String?
  output      String?
  error       String?
  metadata    String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  steps ExecutionStep[]
  @@index([workspaceId, startedAt])
  @@index([agentId, startedAt])
  @@index([workflowId, startedAt])
  @@index([status, startedAt])
}

model ExecutionStep {
  id          String   @id @default(cuid())
  executionId String
  seq         Int
  type        String
  name        String
  status      String   @default("RUNNING")
  input       String?
  output      String?
  error       String?
  metadata    String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  @@unique([executionId, seq])
  @@index([executionId, seq])
}

model MemoryEntry {
  id             String   @id @default(cuid())
  workspaceId    String
  agentId        String
  conversationId String?
  scope          String   @default("conversation")
  subjectKey     String?
  type           String   @default("fact")
  key            String
  value          String
  metadata       String?
  importance     Int      @default(60)
  confidence     Int      @default(80)
  source         String   @default("explicit")
  lastAccessedAt DateTime @default(now())
  expiresAt      DateTime?
  supersededById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([agentId, updatedAt])
  @@index([agentId, subjectKey, updatedAt])
  @@index([conversationId, updatedAt])
  @@index([workspaceId, updatedAt])
  @@index([agentId, scope, subjectKey, importance, updatedAt])
  @@index([agentId, expiresAt])
}

model AgentProviderHealth {
  id                 String   @id @default(cuid())
  agentId            String   @unique
  workspaceId        String
  state              String   @default("healthy")
  consecutiveFailures Int     @default(0)
  openedUntil        DateTime?
  lastCode           String?
  lastStatus         Int?
  lastLatencyMs      Int?
  lastError          String?
  lastErrorAt        DateTime?
  lastSuccessAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@index([openedUntil])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

model Plugin {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  version     String   @default("1.0.0")
  enabled     Boolean  @default(true)
  manifest    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}
