generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]      @relation("WorkspaceOwner")
  conversations   Conversation[]
  usageEvents     UsageEvent[]
  auditLogs       AuditLog[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        WorkspaceMember[]
  agents         Agent[]
  providerConfig ProviderConfig?
  telegramBots   TelegramBot[]
  usageEvents    UsageEvent[]
  auditLogs      AuditLog[]
  usagePolicy    UsagePolicy?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  orgName      String?
  description  String?
  language     String   @default("fa")
  tone         String   @default("professional")
  customTone       String?
  instructions     String?
  persona          String?
  systemPrompt     String?
  temperature      Float    @default(0.7)
  topP             Float    @default(1.0)
  maxTokens        Int      @default(1200)
  memoryEnabled    Boolean  @default(true)
  citationsEnabled Boolean  @default(true)
  status           String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeSources KnowledgeSource[]
  conversations    Conversation[]
  usageEvents      UsageEvent[]
  telegramBots     TelegramBot[]
  apiKeys          AgentApiKey[]

  @@index([workspaceId])
}

model AgentApiKey {
  id         String   @id @default(cuid())
  agentId    String
  name       String
  keyHash    String   @unique
  keyPrefix  String
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, active])
}

model KnowledgeSource {
  id        String   @id @default(cuid())
  agentId   String
  name      String
  type      String
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@index([agentId])
  @@index([status])
}

model KnowledgeDocument {
  id         String   @id @default(cuid())
  sourceId   String
  name       String
  mimeType   String?
  sizeBytes  Int?
  url        String?
  status     String   @default("pending")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([sourceId])
}

model KnowledgeChunk {
  id          String   @id
  documentId  String
  sourceId    String
  agentId     String
  workspaceId String
  seq         Int
  text        String
  page        Int?
  section     String?
  sourceUrl   String?
  metadata    String?
  createdAt   DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([agentId])
  @@index([sourceId])
}

model VectorPoint {
  id          String   @id
  agentId     String
  workspaceId String
  sourceId    String
  documentId  String
  vector      String
  dims        Int
  payload     String
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([workspaceId])
  @@index([sourceId])
}

model Conversation {
  id             String   @id @default(cuid())
  agentId        String
  userId         String?
  title          String   @default("گفتگوی جدید")
  channel        String   @default("web")
  externalUserId String?
  telegramBotId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramBot TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([agentId])
  @@index([userId])
  @@index([telegramBotId])
  @@index([externalUserId])
  @@index([channel])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
}

model ProviderConfig {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  providerName    String
  baseUrl         String
  model           String
  authMode        String   @default("bearer")
  apiKeyEncrypted String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsagePolicy {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  dailyMessageLimit     Int      @default(0)
  monthlyMessageLimit  Int      @default(0)
  dailyTokenLimit      Int      @default(0)
  monthlyTokenLimit    Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model TelegramBot {
  id                    String   @id @default(cuid())
  workspaceId           String
  agentId               String
  name                  String
  tokenEncrypted        String
  username              String?
  status                String   @default("disconnected")
  mode                  String   @default("webhook")
  webhookSecretEncrypted String?
  lastError             String?
  lastSeenAt            DateTime?
  lastUpdateId          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent      Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  allowlist  TelegramAllowlistEntry[]
  users      TelegramUser[]
  conversations Conversation[]
  usageEvents UsageEvent[]

  @@index([workspaceId])
  @@index([agentId])
  @@index([status])
}

model TelegramAllowlistEntry {
  id          String   @id @default(cuid())
  botId       String
  phoneNumber String
  displayName String?
  notes       String?
  status      String   @default("allowed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, phoneNumber])
  @@index([botId, status])
}

model TelegramUser {
  id             String   @id @default(cuid())
  botId          String
  telegramUserId String
  phoneNumber    String?
  username       String?
  firstName      String?
  lastName       String?
  status         String   @default("pending")
  dailyMessageLimit   Int   @default(0)
  monthlyMessageLimit Int   @default(0)
  dailyTokenLimit     Int   @default(0)
  monthlyTokenLimit   Int   @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]

  @@unique([botId, telegramUserId])
  @@index([botId, status])
}

model UsageEvent {
  id                 String   @id @default(cuid())
  workspaceId        String
  agentId            String?
  userId             String?
  telegramBotId      String?
  telegramUserId     String?
  channel            String   @default("web")
  provider           String?
  model              String?
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  totalTokens        Int      @default(0)
  estimatedCostMicros Int     @default(0)
  createdAt          DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramBot TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)
  telegramUser TelegramUser? @relation(fields: [telegramUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([telegramBotId, createdAt])
  @@index([telegramUserId, createdAt])
  @@index([channel, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, createdAt])
}


model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

model Plugin {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  version     String   @default("1.0.0")
  enabled     Boolean  @default(true)
  manifest    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}
